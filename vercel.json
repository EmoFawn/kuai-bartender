{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/bartend",   "dest": "/api/bartend.js"   },
    { "src": "/api/moodblend", "dest": "/api/moodblend.js" },
    { "src": "/api/mix",       "dest": "/api/mix.js"       },
    { "src": "/(.*)",          "dest": "/$1"               }
  ]
}
